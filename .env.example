# GEMINI_API_KEY: Optional - Used for AI WhatsApp caption generation
GEMINI_API_KEY=""

# Cashfree Payment Gateway (Optional - required to accept Card / Net Banking)
# Get credentials from DashBoard > Settings > API Keys at https://dashboard.cashfree.com
CASHFREE_ENABLED="true"
# "sandbox" for testing (test cards given by Cashfree), "prod" for live payments
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_CLIENT_ID=""
CASHFREE_SECRET_KEY=""
# Optional - defaults to 2022-09-01
# CASHFREE_API_VERSION="2022-09-01"
